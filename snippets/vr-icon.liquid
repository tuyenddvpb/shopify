{%- comment -%}
  VitalRay line icons (24x24, stroke = currentColor).
  Usage: {% render 'vr-icon', name: 'shield', size: 22 %}
  Unknown names fall back to printing the text (lets old emoji settings keep working).
{%- endcomment -%}
{%- liquid
  assign size = size | default: 22
  assign known = 'shield,truck,lock,chat,clock,battery,hand,light,return,check,star,leaf,box,heart,bolt,sparkle,mail,arrow'
  assign names = known | split: ','
-%}
{%- if names contains name -%}
  <svg class="vr-svg vr-svg--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case name -%}
      {%- when 'shield' -%}<path d="M12 3l7 3v5.5c0 4.3-2.9 8-7 9.5-4.1-1.5-7-5.2-7-9.5V6l7-3z"/><path d="M9 12l2 2 4-4"/>
      {%- when 'truck' -%}<path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
      {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/><path d="M12 14.5v2.5"/>
      {%- when 'chat' -%}<path d="M20 12a7.5 7.5 0 01-11 6.6L4 20l1.4-4.6A7.5 7.5 0 1120 12z"/><path d="M9 11h.01M12.5 11h.01M16 11h.01"/>
      {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- when 'battery' -%}<rect x="3" y="7.5" width="16" height="9" rx="2"/><path d="M21 10.5v3"/><path d="M10.5 9.5l-2 3h3l-2 3"/>
      {%- when 'hand' -%}<path d="M8 12V5.5a1.5 1.5 0 013 0V11"/><path d="M11 10.5V4a1.5 1.5 0 013 0v6.5"/><path d="M14 10.5V5.5a1.5 1.5 0 013 0V13"/><path d="M8 12.5V9.5a1.5 1.5 0 00-3 0v4.5a7 7 0 007 7h1a6 6 0 006-6V11a1.5 1.5 0 00-3 0"/>
      {%- when 'light' -%}<path d="M5 16a7 7 0 0114 0"/><path d="M3 19.5h18"/><path d="M12 4v2.5M5.6 6.6l1.8 1.8M18.4 6.6l-1.8 1.8M2.5 12h2M19.5 12h2"/>
      {%- when 'return' -%}<path d="M4 12a8 8 0 108-8 8.4 8.4 0 00-6 2.5L4 8.5"/><path d="M4 4v4.5h4.5"/>
      {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
      {%- when 'star' -%}<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8 6.8 19.6l1-5.8L3.5 9.7l5.9-.9L12 3.5z"/>
      {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19c3-4 6-6.5 9-8"/>
      {%- when 'box' -%}<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/>
      {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10A4.5 4.5 0 0112 7a4.5 4.5 0 017.5 3c0 5.4-7.5 10-7.5 10z"/>
      {%- when 'bolt' -%}<path d="M13 3L5 13.5h6L10 21l8-10.5h-6L13 3z"/>
      {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M18.5 16l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>
      {%- when 'mail' -%}<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>
      {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- endcase -%}
  </svg>
{%- else -%}
  {{- name -}}
{%- endif -%}
