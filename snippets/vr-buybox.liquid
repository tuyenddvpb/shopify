{%- comment -%}
  Short product title + price line for VitalRay buy boxes.
  Usage:
    {% render 'vr-buybox', product: product, part: 'title', tag: 'h1' %}
    {% render 'vr-buybox', product: product, part: 'price' %}
    {% render 'vr-buybox', product: product, part: 'stock' %}
  The product title is split on " – ": the first part is the short name,
  the rest becomes the subtitle.
{%- endcomment -%}
{%- liquid
  assign tag = tag | default: 'h2'
  assign title_parts = product.title | split: ' – '
  assign short_title = title_parts | first
  assign subtitle = ''
  if title_parts.size > 1
    assign subtitle = title_parts | last
  endif
  assign v = product.selected_or_first_available_variant
-%}
{%- case part -%}
  {%- when 'title' -%}
    <div class="vr-pdp-head">
      <{{ tag }} class="vr-pdp-title">{{ short_title }}</{{ tag }}>
      {%- if subtitle != '' -%}<p class="vr-pdp-subtitle">{{ subtitle }}</p>{%- endif -%}
    </div>
  {%- when 'price' -%}
    <div class="vr-price">
      <span class="vr-price__now">{{ v.price | money }}</span>
      {%- if v.compare_at_price > v.price -%}
        {%- assign save = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
        <s class="vr-price__was">{{ v.compare_at_price | money }}</s>
        <span class="vr-save">Save {{ save }}%</span>
      {%- endif -%}
    </div>
    <p class="vr-price__note">{% render 'vr-icon', name: 'truck', size: 16 %} Free tracked shipping · 90-day guarantee</p>
  {%- when 'stock' -%}
    <p class="vr-stock"><span class="vr-stock__dot" aria-hidden="true"></span><strong>In stock</strong> · Ships in 1–3 business days</p>
  {%- when 'bundle' -%}
    {%- liquid
      assign one = v.price
      assign two_full = v.price | times: 2
      # Match Shopify's automatic discount: 15% off each unit, rounded down to the cent.
      assign unit_off = v.price | times: 15 | divided_by: 100
      assign two_each = v.price | minus: unit_off
      assign two = two_each | times: 2
      assign two_was = v.compare_at_price | times: 2
      if two_was < two_full
        assign two_was = two_full
      endif
    -%}
    <fieldset class="vr-bundle" data-vr-bundle>
      <legend class="vr-bundle__legend">Choose your bundle</legend>
      <label class="vr-bundle__opt">
        <input type="radio" name="vr-bundle" value="1" checked>
        <span class="vr-bundle__radio" aria-hidden="true"></span>
        <span class="vr-bundle__main"><strong>1 × VitalRay Wrist</strong><small>For one hand</small></span>
        <span class="vr-bundle__price"><strong>{{ one | money }}</strong>{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}</span>
      </label>
      <label class="vr-bundle__opt">
        <input type="radio" name="vr-bundle" value="2">
        <span class="vr-bundle__radio" aria-hidden="true"></span>
        <span class="vr-bundle__tag">Best value</span>
        <span class="vr-bundle__main"><strong>2 × VitalRay Wrist</strong><small>Both hands · {{ two_each | money }} each · extra 15% off</small></span>
        <span class="vr-bundle__price"><strong>{{ two | money }}</strong><s>{{ two_was | money }}</s></span>
      </label>
    </fieldset>
  {%- when 'specs' -%}
    <ul class="vr-specs" role="list">
      <li>{% render 'vr-icon', name: 'light', size: 22 %}<span>660 + 850<br>nm</span></li>
      <li>{% render 'vr-icon', name: 'clock', size: 22 %}<span>15-min<br>sessions</span></li>
      <li>{% render 'vr-icon', name: 'bolt', size: 22 %}<span>3 intensity<br>levels</span></li>
      <li>{% render 'vr-icon', name: 'battery', size: 22 %}<span>Cordless<br>USB-C</span></li>
    </ul>
  {%- when 'assurance' -%}
    {%- comment -%} Delivery estimate (filled in by vitalray.js; text fallback below), payment icons and support line. Ranges mirror the shipping policy: 1–3 processing + 7–15 delivery business days. {%- endcomment -%}
    <div class="vr-assure">
      <ol class="vr-eta" data-vr-eta data-ship-min="1" data-ship-max="3" data-arrive-min="8" data-arrive-max="18" role="list">
        <li><span class="vr-eta__icon">{% render 'vr-icon', name: 'check', size: 16 %}</span><strong>Order today</strong><span data-vr-eta-today>&nbsp;</span></li>
        <li><span class="vr-eta__icon">{% render 'vr-icon', name: 'box', size: 16 %}</span><strong>Ships</strong><span data-vr-eta-ship>1–3 business days</span></li>
        <li><span class="vr-eta__icon">{% render 'vr-icon', name: 'truck', size: 16 %}</span><strong>Arrives</strong><span data-vr-eta-arrive>8–18 business days</span></li>
      </ol>
      <p class="vr-eta__note">Free tracked shipping · estimated delivery to the US, CA, UK &amp; AU</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="vr-paylist" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p class="vr-support">{% render 'vr-icon', name: 'chat', size: 16 %}<span>Questions before you buy? A real person replies within 1 business day — <a href="mailto:support@vitalray.shop">support@vitalray.shop</a></span></p>
    </div>
  {%- when 'short' -%}
    {{- short_title -}}
{%- endcase -%}
