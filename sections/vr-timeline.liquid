<section class="vr-section vr-section--{{ section.settings.background }}">
  <div class="vr-container" style="max-width:900px">
    <div class="vr-center" data-vr-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vr-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="vr-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="vr-timeline" data-vr-reveal-group>
      {%- for block in section.blocks -%}
        <div class="vr-card vr-timeline__item" {{ block.shopify_attributes }} data-vr-reveal>
          <div class="vr-timeline__when">{{ block.settings.when }}</div>
          <div class="vr-timeline__body">
            <h3 class="vr-timeline__title">{{ block.settings.title }}</h3>
            {{ block.settings.text }}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="vr-footnote vr-center">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VR Timeline",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "sage",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Building the habit" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Consistency matters more than intensity. Here's a simple way to make VitalRay part of your day." },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Everyone is different. Talk to your doctor if you have a medical condition." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "when", "label": "When", "default": "Week 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Get started" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<ul><li>Point one</li><li>Point two</li></ul>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VR Timeline",
      "blocks": [
        { "type": "step", "settings": { "when": "Day 1", "title": "Find your fit", "text": "<ul><li>Charge the wrap fully</li><li>Try the lowest intensity first</li></ul>" } },
        { "type": "step", "settings": { "when": "Week 1–2", "title": "Make it a habit", "text": "<ul><li>Pair it with something you already do — coffee, TV, reading</li><li>One 15-minute session a day</li></ul>" } },
        { "type": "step", "settings": { "when": "Week 3+", "title": "Keep it going", "text": "<ul><li>Stay consistent</li><li>Adjust intensity and mode to what feels best</li></ul>" } }
      ]
    }
  ]
}
{% endschema %}
