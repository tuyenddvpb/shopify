{% render 'ns-lp-head' %}
<section class="ns-lp ns-lp--{{ section.settings.bg }} ns-lp__pad">
  <div class="ns-lp__wrap ns-lp__center">
    {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="ns-lp__h">{{ section.settings.heading }}</h2>
    <div class="ns-lp-specs">{%- for block in section.blocks -%}<div class="ns-lp-spec" {{ block.shopify_attributes }}><small>{{ block.settings.label }}</small><strong>{{ block.settings.value }}</strong></div>{%- endfor -%}</div>
  </div>
</section>
{% schema %}
{ "name": "LP Specs grid", "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [{"value":"white","label":"White"},{"value":"cream","label":"Cream"},{"value":"sky","label":"Light blue"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" } ],
  "blocks": [{ "type": "spec", "name": "Spec", "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Label" },
    { "type": "text", "id": "value", "label": "Value", "default": "Value" } ] }],
  "presets": [{ "name": "LP Specs grid" }] }
{% endschema %}
