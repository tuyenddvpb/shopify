{%- comment -%}
  Kindhand: wide split banner (image + text), used for the home hero and for each category.
  With no image, it shows up to 3 product images from the chosen collection, or a soft color panel.
{%- endcomment -%}
{%- assign c = section.settings.collection -%}
{%- assign link = section.settings.button_link | default: c.url | default: routes.all_products_collection_url -%}
<section class="kh-banner kh-banner--{{ section.settings.tone }} kh-banner--{{ section.settings.size }} kh-banner--img-{{ section.settings.image_side }}">
  <div class="kh-banner__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 55vw, 100vw', class: 'kh-banner__img' }}
    {%- elsif c != blank and c.products_count > 0 -%}
      <div class="kh-banner__collage kh-banner__collage--{{ c.products_count | at_most: 3 }}">
        {%- for p in c.products limit: 3 -%}
          {%- if p.featured_image -%}
            {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: p.title }}
          {%- else -%}
            <span class="kh-banner__blank" aria-hidden="true"></span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <span class="kh-banner__blank" aria-hidden="true"></span>
    {%- endif -%}
  </div>
  <div class="kh-banner__body" data-vr-reveal>
    {%- if section.settings.heading != blank -%}<h2 class="kh-banner__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.tagline != blank -%}<p class="kh-banner__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="kh-banner__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="kh-banner__btn" href="{{ link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KH Promo banner",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "default": "regular",
      "options": [
        { "value": "hero", "label": "Hero (large)" },
        { "value": "regular", "label": "Regular" }
      ]
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Color",
      "default": "blush",
      "options": [
        { "value": "blush", "label": "Blush" },
        { "value": "sand", "label": "Sand" },
        { "value": "sage", "label": "Sage" },
        { "value": "plum", "label": "Plum" }
      ]
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Button goes here. Its products are shown when no image is set." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to our shop" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Everyday finds, made simple" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Optional. Defaults to the collection." }
  ],
  "presets": [ { "name": "KH Promo banner" } ]
}
{% endschema %}
