{% render 'ns-ks-head' %}
<section class="ks ks-cta">
  {%- if section.settings.eyebrow != blank -%}<p class="ks__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="ks__h">{{ section.settings.heading }}</h2>
  {%- if section.settings.text != blank -%}<p class="ks__p">{{ section.settings.text }}</p>{%- endif -%}
  <a class="ks-btn" href="{{ section.settings.link | default: '#ks-buy' }}">{{ section.settings.label }}</a>
</section>
{% schema %}
{ "name": "KS Final CTA", "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "label", "label": "Button label", "default": "Shop now" },
    { "type": "text", "id": "link", "label": "Button link", "default": "#ks-buy" } ],
  "presets": [{ "name": "KS Final CTA" }] }
{% endschema %}
