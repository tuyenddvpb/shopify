{%- comment -%} Only renders when it has review blocks. Add genuine customer reviews only. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{% render 'ns-lp-head' %}
<section class="ns-lp ns-lp--{{ section.settings.bg }} ns-lp__pad">
  <div class="ns-lp__wrap ns-lp__center">
    {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="ns-lp__h">{{ section.settings.heading }}</h2>
    <div class="ns-lp-reviews">{%- for block in section.blocks -%}<div class="ns-lp-review" {{ block.shopify_attributes }}><div class="ns-lp-review__stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</div><p>“{{ block.settings.quote }}”</p><strong>{{ block.settings.name }}</strong></div>{%- endfor -%}</div>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "LP Reviews", "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [{"value":"white","label":"White"},{"value":"cream","label":"Cream"},{"value":"sky","label":"Light blue"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "paragraph", "content": "Hidden until you add at least one review. Only add real customer reviews." } ],
  "blocks": [{ "type": "review", "name": "Review", "settings": [
    { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "quote", "label": "Review text" },
    { "type": "text", "id": "name", "label": "Customer name" } ] }],
  "presets": [{ "name": "LP Reviews" }] }
{% endschema %}
