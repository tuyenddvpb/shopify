{% render 'ns-lp-head' %}
<section class="ns-lp ns-lp--{{ section.settings.bg }} ns-lp__pad">
  <div class="ns-lp__wrap ns-lp__center">
    {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="ns-lp__h">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}<p class="ns-lp__sub">{{ section.settings.sub }}</p>{%- endif -%}
    <table class="ns-lp-cmp">
      <thead><tr><th></th><th class="ns-lp-cmp__us">{{ section.settings.col_a }}</th><th>{{ section.settings.col_b }}</th></tr></thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.label }}</th>
            <td class="ns-lp-cmp__us">{% if block.settings.a %}<span class="ns-lp-cmp__yes" aria-label="Yes">&#10003;</span>{% else %}<span class="ns-lp-cmp__no" aria-label="No">&#10005;</span>{% endif %}</td>
            <td>{% if block.settings.b %}<span class="ns-lp-cmp__yes" aria-label="Yes">&#10003;</span>{% else %}<span class="ns-lp-cmp__no" aria-label="No">&#10005;</span>{% endif %}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    {%- if section.settings.note != blank -%}<p class="ns-lp-cmp__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "LP Comparison table", "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [{"value":"white","label":"White"},{"value":"cream","label":"Cream"},{"value":"sky","label":"Light blue"},{"value":"navy","label":"Navy"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it compares" },
    { "type": "text", "id": "sub", "label": "Subheading" },
    { "type": "text", "id": "col_a", "label": "Column A (ours)", "default": "Ours" },
    { "type": "text", "id": "col_b", "label": "Column B", "default": "Others" },
    { "type": "text", "id": "note", "label": "Footnote" } ],
  "blocks": [{ "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
    { "type": "checkbox", "id": "a", "label": "Column A has it", "default": true },
    { "type": "checkbox", "id": "b", "label": "Column B has it", "default": false } ] }],
  "presets": [{ "name": "LP Comparison table" }] }
{% endschema %}
