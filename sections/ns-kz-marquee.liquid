{% render 'ns-kz-head' %}
<section class="kz kz--navy kz__pad" style="padding-bottom:24px">
  <div class="kz__wrap kz__center">{% render 'ns-kz-heading', s: section.settings %}</div>
  {%- if section.blocks.size > 0 -%}
  <div style="overflow:hidden;border-bottom:1px solid #2A3E5C"><div class="kz-marq__track" aria-hidden="true">
    {%- for i in (1..2) -%}{%- for block in section.blocks -%}<span class="kz-marq__item">{{ block.settings.text }}</span>{%- endfor -%}{%- endfor -%}
  </div></div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "KZ Marquee band", "tag": "div",
  "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "accent", "label": "Heading second line (accent color on dark)" },
    { "type": "textarea", "id": "sub", "label": "Subheading" },
    { "type": "header", "content": "Scrolling words" } ],
  "blocks": [{ "type": "item", "name": "Word", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Four-wheel base" }] }],
  "presets": [{ "name": "KZ Marquee band" }] }
{% endschema %}
