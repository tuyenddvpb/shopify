{% render 'ns-lp-head' %}
<section class="ns-lp ns-lp--{{ section.settings.bg }} ns-lp__pad">
  <div class="ns-lp__wrap ns-lp__center">
    {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="ns-lp__h">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}<p class="ns-lp__sub">{{ section.settings.sub }}</p>{%- endif -%}
    <div class="ns-lp__frame ns-lp-wide__media{% if section.settings.narrow %} ns-lp-wide__media--narrow{% endif %}">{% render 'ns-lp-media', image: section.settings.image, hint: section.settings.heading, sizes: '(min-width: 1240px) 1200px, 100vw' %}</div>
    {%- if section.blocks.size > 0 -%}
      <div class="ns-lp-cols" style="text-align:left">
        {%- for block in section.blocks -%}
          <div class="ns-lp-col" {{ block.shopify_attributes }}><span class="ns-lp-col__icon">{% render 'vr-icon', name: block.settings.icon, size: 22 %}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "LP Wide image + columns", "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [{"value":"white","label":"White"},{"value":"cream","label":"Cream"},{"value":"sky","label":"Light blue"},{"value":"navy","label":"Navy"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "sub", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow square image", "default": false } ],
  "blocks": [{ "type": "col", "name": "Column", "settings": [
    { "type": "text", "id": "icon", "label": "Icon name", "default": "check" },
    { "type": "text", "id": "title", "label": "Title", "default": "Title" },
    { "type": "text", "id": "text", "label": "Text" } ] }],
  "presets": [{ "name": "LP Wide image + columns" }] }
{% endschema %}
