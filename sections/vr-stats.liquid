{%- comment -%}
  Only publish numbers you can back up (real reviews, real order counts, your own survey).
{%- endcomment -%}
<section class="vr-section vr-section--{{ section.settings.background }}">
  <div class="vr-container">
    <div class="vr-center">
      {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="vr-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="vr-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="vr-grid vr-grid--{{ section.blocks.size | at_most: 4 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <div class="vr-stat" {{ block.shopify_attributes }}>
          <div class="vr-stat__value">{{ block.settings.value }}</div>
          <div class="vr-stat__label">{{ block.settings.label }}</div>
          {%- if block.settings.note != blank -%}<div class="vr-stat__note">{{ block.settings.note }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="vr-footnote vr-center">{{ section.settings.footnote }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p class="vr-center" style="margin-top:32px">
        <a class="vr-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VR Stats",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "dark",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the wrap" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small device. Thoughtful design." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "info": "Use for sources or disclaimers when you show customer results."
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "15 min" },
        { "type": "text", "id": "label", "label": "Label", "default": "Per session" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VR Stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "660 + 850", "label": "Nanometer wavelengths", "note": "Red & near-infrared" } },
        { "type": "stat", "settings": { "value": "15 min", "label": "Per session", "note": "Auto shut-off timer" } },
        { "type": "stat", "settings": { "value": "3", "label": "Intensity levels", "note": "Pick what feels right" } },
        { "type": "stat", "settings": { "value": "0", "label": "Cords while in use", "note": "USB-C rechargeable" } }
      ]
    }
  ]
}
{% endschema %}
