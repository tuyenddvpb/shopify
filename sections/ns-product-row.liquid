{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign c = section.settings.collection
  assign limit = section.settings.limit
  assign url = c.url | default: routes.all_products_collection_url
  assign items = blank
  if c != blank and c.products_count > 0
    assign items = c.products
  elsif section.settings.use_all and collections.all.products_count > 0
    assign items = collections.all.products
  endif
-%}
<section class="ns-section ns-row" data-ns-row>
  <div class="page-width">
    <div class="ns-row__head">
      {%- if section.settings.heading != blank -%}<h2 class="ns-title">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="ns-row__nav">
        <a class="ns-link" href="{{ url }}">View all</a>
        <button type="button" class="ns-row__arrow" data-ns-prev aria-label="Previous products">‹</button>
        <button type="button" class="ns-row__arrow" data-ns-next aria-label="Next products">›</button>
      </div>
    </div>
    <ul class="ns-row__track" role="list" data-ns-track>
      {%- if items != blank -%}
        {%- for product in items limit: limit -%}
          <li class="ns-row__item">
            {% render 'card-product', card_product: product, media_aspect_ratio: 'square', image_shape: 'default', show_secondary_image: true, show_vendor: false, show_rating: false, skip_styles: true, section_id: section.id, quick_add: 'standard', product_view_context: 'collection' %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="ns-row__item">
            <div class="ns-ph-card">
              <span class="ns-ph-card__img">{{ 'product-' | append: i | placeholder_svg_tag: 'ns-placeholder' }}</span>
              <span class="ns-ph-card__t">Your product name</span>
              <span class="ns-ph-card__p">$24.99</span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "NS Product row",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending now" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "use_all", "label": "Show newest products when no collection is set", "default": true },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 1, "default": 10 }
  ],
  "presets": [{ "name": "NS Product row" }]
}
{% endschema %}
