<section class="vr-section vr-section--{{ section.settings.background }}">
  <div class="vr-container">
    <div class="vr-center" data-vr-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="vr-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="vr-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="vr-grid vr-grid--{{ section.settings.columns }}" data-vr-reveal-group>
      {%- for block in section.blocks -%}
        <div class="vr-card" {{ block.shopify_attributes }} data-vr-reveal>
          {%- if section.settings.numbered -%}
            <div class="vr-step__num">{{ forloop.index }}</div>
          {%- elsif block.settings.image != blank -%}
            <div class="vr-feature__icon">
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;height:auto;border-radius:10px' }}
            </div>
          {%- elsif block.settings.icon != blank -%}
            <div class="vr-feature__icon"><span class="vr-icon" aria-hidden="true">{% render 'vr-icon', name: block.settings.icon, size: 22 %}</span></div>
          {%- endif -%}
          <h3 class="vr-feature__title">{{ block.settings.title }}</h3>
          <div class="vr-feature__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <p class="vr-center" style="margin-top:36px">
        <a class="vr-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'vr-icon', name: 'arrow', size: 18 %}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VR Features / Steps",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why VitalRay" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for real routines" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "checkbox", "id": "numbered", "label": "Show step numbers instead of icons", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✦" },
        { "type": "image_picker", "id": "image", "label": "Image (optional, replaces icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the benefit in one or two short sentences.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VR Features / Steps",
      "blocks": [
        { "type": "feature", "settings": { "icon": "💡", "title": "Two wavelengths", "text": "<p>Red (660nm) and near-infrared (850nm) light in one wrap.</p>" } },
        { "type": "feature", "settings": { "icon": "🔋", "title": "Cordless", "text": "<p>Charge with USB-C, then use it anywhere — no outlet needed.</p>" } },
        { "type": "feature", "settings": { "icon": "🤲", "title": "Fits either hand", "text": "<p>Adjustable strap and thumb loop for a snug, comfortable fit.</p>" } }
      ]
    }
  ]
}
{% endschema %}
