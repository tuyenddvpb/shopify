{% render 'ns-ks-head' %}
{%- assign cols = section.settings.cols | split: '|' -%}
<section class="ks ks-cmp-sec">
  <div class="ks-cmp-sec__art">{%- if section.settings.bg_art != blank -%}{{ section.settings.bg_art | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '', sizes: '50vw' }}{%- else -%}<img src="{{ 'ns-ks-lineart.jpg' | asset_url }}" alt="" loading="lazy" width="1100" height="1100">{%- endif -%}</div>
  <div class="ks__wrap ks__pad ks-cmp">
    <div class="ks-cmp__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="ks__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ks__h">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ks__p">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="ks-cmp__scroll">
      <table>
        <thead><tr><th class="ks-cmp__corner"></th>
          {%- for c in cols -%}
            {%- capture key -%}col{{ forloop.index }}_img{%- endcapture -%}
            {%- assign cimg = section.settings[key] -%}
            <th class="ks-cmp__head{% if forloop.first %} is-us{% endif %}"><span class="ks-cmp__name">{{ c | strip }}</span>
              {%- if cimg != blank -%}<span class="ks-cmp__pic">{{ cimg | image_url: width: 300 | image_tag: loading: 'lazy', alt: c, sizes: '120px' }}</span>{%- endif -%}
            </th>
          {%- endfor -%}
        </tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
          {%- assign vals = block.settings.values | split: '|' -%}
          <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th>
            {%- for v in vals -%}
              {%- assign raw = v | strip -%}{%- assign mark = raw | slice: 0, 2 -%}{%- assign txt = raw | slice: 2, 200 | strip -%}
              <td class="{% if forloop.first %}is-us{% endif %}"><span class="ks-cmp__cell">
                {%- case mark -%}
                  {%- when 'y:' -%}<span class="ks-cmp__ic ks-cmp__ic--yes" aria-label="Yes">&#10003;</span>{{ txt }}
                  {%- when 'n:' -%}<span class="ks-cmp__ic ks-cmp__ic--no" aria-label="No">&#10005;</span>{{ txt }}
                  {%- when 'w:' -%}<span class="ks-cmp__ic ks-cmp__ic--warn" aria-label="Caution">!</span>{{ txt }}
                  {%- else -%}{{ raw }}
                {%- endcase -%}
              </span></td>
            {%- endfor -%}
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
      {%- if section.settings.note != blank -%}<p class="ks-note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "KS Comparison", "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "How it compares" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "bg_art", "label": "Background art (left side)", "info": "Leave empty to use the built-in line drawing." },
    { "type": "text", "id": "cols", "label": "Column names, separated by |", "default": "Ours|Other" },
    { "type": "image_picker", "id": "col1_img", "label": "Column 1 image" },
    { "type": "image_picker", "id": "col2_img", "label": "Column 2 image" },
    { "type": "image_picker", "id": "col3_img", "label": "Column 3 image" },
    { "type": "image_picker", "id": "col4_img", "label": "Column 4 image" },
    { "type": "text", "id": "note", "label": "Footnote" } ],
  "blocks": [{ "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "label", "label": "Row label", "default": "Feature" },
    { "type": "text", "id": "values", "label": "Values (separated by |)", "info": "Prefix a value with y: n: or w: to show a check, cross or caution icon.", "default": "y:|n:" } ] }],
  "presets": [{ "name": "KS Comparison" }] }
{% endschema %}
