<section class="vr-section vr-section--{{ section.settings.background }}">
  <div class="vr-container">
    <div class="vr-center">
      {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vr-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="vr-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="vr-grid vr-grid--{{ section.blocks.size | at_most: 3 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        {%- assign card_link = block.settings.link | default: routes.all_products_collection_url -%}
        <a class="vr-card vr-catcard" href="{{ card_link }}" {{ block.shopify_attributes }}>
          <div class="vr-catcard__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw' }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="vr-catcard__body">
            {%- if block.settings.tag != blank -%}<span class="vr-catcard__tag">{{ block.settings.tag }}</span>{%- endif -%}
            <h3 class="vr-feature__title">{{ block.settings.title }}</h3>
            <p class="vr-feature__text">{{ block.settings.text }}</p>
            {%- if block.settings.link_label != blank -%}
              <p class="vr-catcard__link">{{ block.settings.link_label }} →</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VR Category cards",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by need" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your routine" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Light therapy devices and the essentials that go with them." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Best seller" },
        { "type": "text", "id": "title", "label": "Title", "default": "Light therapy devices" },
        { "type": "text", "id": "text", "label": "Text", "default": "Wearable red & near-infrared light for hands and wrists." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VR Category cards",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "tag": "Coming soon",
            "title": "Comfort essentials",
            "text": "Accessories to make your daily session easier.",
            "link_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
