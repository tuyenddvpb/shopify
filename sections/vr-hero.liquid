<section class="vr-section vr-section--{{ section.settings.background }} vr-hero">
  <div class="vr-container vr-hero__grid">
    <div class="vr-hero__content">
      {%- if section.settings.trust_text != blank -%}
        <div class="vr-hero__trust"><span class="vr-hero__trust-dot" aria-hidden="true"></span>{{ section.settings.trust_text }}</div>
      {%- endif -%}
      <h1 class="vr-heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="vr-sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="vr-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label }} <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="vr-hero__badges">
          {%- for block in section.blocks -%}
            <span class="vr-pill" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="vr-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400'
        }}
      {%- elsif section.settings.product != blank and section.settings.product.featured_image -%}
        {{
          section.settings.product.featured_image
          | image_url: width: 1400
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.product.title
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VR Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "Designed for everyday hand & wrist comfort" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gentle red light care for <em>hard-working hands</em>" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>A cordless red & near-infrared light wrap you can use at home, at your desk or on the couch — just 15 minutes a day.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop VitalRay" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "product",
      "id": "product",
      "label": "Fallback product",
      "info": "If no image is selected, the product's main image is shown."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✓" },
        { "type": "text", "id": "text", "label": "Text", "default": "15-minute sessions" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VR Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "⏱", "text": "15-minute sessions" } },
        { "type": "badge", "settings": { "icon": "🔋", "text": "Cordless & rechargeable" } },
        { "type": "badge", "settings": { "icon": "🚚", "text": "Free shipping" } }
      ]
    }
  ]
}
{% endschema %}
