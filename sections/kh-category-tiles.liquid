{%- comment -%}
  Kindhand: shop-by-category tiles. Each tile links to a collection.
  Image order: tile image, then collection image, then the collection's first product image, then a soft color panel.
{%- endcomment -%}
<section class="vr-section vr-section--{{ section.settings.background }} kh-cats">
  <div class="vr-container">
    {%- if section.settings.heading != blank -%}
      <div class="vr-center" data-vr-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="vr-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="kh-cats__grid" style="--kh-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign title = block.settings.title | default: c.title | default: 'Category' -%}
        {%- assign link = c.url | default: routes.all_products_collection_url -%}
        {%- assign img = block.settings.image | default: c.image | default: c.products.first.featured_image -%}
        <a class="kh-cats__tile kh-tone--{{ forloop.index0 | modulo: 4 }}" href="{{ link }}" {{ block.shopify_attributes }} data-vr-reveal>
          {%- if img != blank -%}
            {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', class: 'kh-cats__img', alt: title }}
          {%- else -%}
            <span class="kh-cats__blank" aria-hidden="true">{{ title | slice: 0 }}</span>
          {%- endif -%}
          <span class="kh-cats__label">{{ title }} <span aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KH Category tiles",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "limit": 8,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection name." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Uses the collection image or its first product when empty." }
      ]
    }
  ],
  "presets": [
    { "name": "KH Category tiles", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}
