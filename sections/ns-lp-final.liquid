{% render 'ns-lp-head' %}
<section class="ns-lp ns-lp--{{ section.settings.bg }} ns-lp__pad">
  <div class="ns-lp__wrap">
    <div class="ns-lp-final__card">
      {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ns-lp__h">{{ section.settings.heading }}</h2>
      <div class="ns-lp-final__media">{% render 'ns-lp-media', image: section.settings.image, ph: 'product-1', width: 700, sizes: '300px' %}</div>
      {%- if product -%}
        {%- assign v0 = product.selected_or_first_available_variant -%}
        <div class="ns-lp-final__price">{% if v0.compare_at_price > v0.price %}<s style="font-size:1.5rem;opacity:.6">{{ v0.compare_at_price | money }}</s>{% endif %}<span>{{ v0.price | money }}</span></div>
        {% render 'ns-lp-form', product: product, fid: 'nslp-final', select: true, qty: true, cls: 'ns-lp-form ns-lp-form--wide' %}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "LP Final buy card", "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [{"value":"white","label":"White"},{"value":"cream","label":"Cream"},{"value":"sky","label":"Light blue"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get yours" },
    { "type": "image_picker", "id": "image", "label": "Image" } ],
  "presets": [{ "name": "LP Final buy card" }] }
{% endschema %}
