{%- comment -%} Grid of image cards (image + title + text). Used on product pages for infographics. {%- endcomment -%}
<section class="vr-section vr-section--{{ section.settings.background }} ns-icards">
  <div class="vr-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="vr-center" data-vr-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="vr-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="vr-sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="ns-icards__grid ns-icards__grid--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ns-icard" data-vr-reveal {{ block.shopify_attributes }}>
          <div class="ns-icard__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 90vw', widths: '450, 700, 900', alt: block.settings.image.alt | default: block.settings.title }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}<h3 class="ns-icard__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="ns-icard__text">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "NS Image cards",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "card", "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "NS Image cards", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] } ]
}
{% endschema %}
