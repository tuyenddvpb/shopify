{% render 'ns-kz-head' %}
<section class="kz kz--{{ section.settings.bg }} kz__pad">
  <div class="kz__wrap kz-split{% if section.settings.media_right %} kz-split--rev{% endif %}">
    <div class="kz-split__media">
      {%- if section.settings.video != blank -%}{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '900x' }}
      {%- elsif section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '550,800,1100' }}
      {%- else -%}<div class="kz__ph"></div>{%- endif -%}
      {%- if section.settings.tag != blank -%}<span class="kz-split__tag">{{ section.settings.tag }}</span>{%- endif -%}
    </div>
    <div>
      {% render 'ns-kz-heading', s: section.settings %}
      {%- if section.settings.text != blank -%}<div class="kz__p">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.show_price and product -%}<p class="kz-price">{{ product.selected_or_first_available_variant.price | money }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="kz-btn" href="{{ section.settings.button_link | default: '#kz-buy' }}" style="margin-top:12px">{{ section.settings.button_label }}</a>{%- endif -%}
      {%- if section.settings.small != blank -%}<p class="kz__p" style="font-size:12px;margin-top:12px">{{ section.settings.small }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "KZ Split", "tag": "div",
  "settings": [ { "type": "select", "id": "bg", "label": "Background", "default": "navy", "options": [{"value":"navy","label":"Navy"},{"value":"white","label":"White"},{"value":"grey","label":"Light grey"}] }, { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "accent", "label": "Heading second line (accent color on dark)" },
    { "type": "textarea", "id": "sub", "label": "Subheading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (replaces image)" },
    { "type": "text", "id": "tag", "label": "Small tag on media" },
    { "type": "checkbox", "id": "media_right", "label": "Media on the right", "default": false },
    { "type": "checkbox", "id": "show_price", "label": "Show product price", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#kz-buy" },
    { "type": "text", "id": "small", "label": "Small print" } ],
  "presets": [{ "name": "KZ Split" }] }
{% endschema %}
