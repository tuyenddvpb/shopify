{% render 'ns-ks-head' %}
<section class="ks">
  <div class="ks-hero__bg"></div>
  <div class="ks__wrap">
    <div class="ks-hero__grid">
      <div class="ks-hero__copy">
        {%- if section.settings.badge != blank -%}<span class="ks-hero__badge">{{ section.settings.badge }}</span>{%- endif -%}
        <h1 class="ks-hero__h">{{ section.settings.heading }}</h1>
        {%- if section.settings.sub != blank -%}<p class="ks-hero__sub">{{ section.settings.sub }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a class="ks-btn" href="{{ section.settings.button_link | default: '#ks-buy' }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
      <div class="ks-hero__media">{% render 'ns-ks-img', img: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw' %}</div>
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
  <div class="ks-strip"><div class="ks-strip__row">
    {%- for block in section.blocks -%}<div class="ks-strip__item" {{ block.shopify_attributes }}>{% render 'vr-icon', name: block.settings.icon, size: 22 %}<span>{{ block.settings.text }}</span></div>{%- endfor -%}
  </div></div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "KS Hero (dark)", "tag": "div",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "sub", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#ks-buy" } ],
  "blocks": [{ "type": "item", "name": "Trust item", "settings": [
    { "type": "text", "id": "icon", "label": "Icon name", "default": "check" },
    { "type": "text", "id": "text", "label": "Text", "default": "Trust point" } ] }],
  "presets": [{ "name": "KS Hero (dark)" }] }
{% endschema %}
