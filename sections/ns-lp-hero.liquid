{% render 'ns-lp-head' %}
{%- if section.settings.topbar != blank -%}<div class="ns-lp ns-lp-topbar">{{ section.settings.topbar }}</div>{%- endif -%}
<section class="ns-lp ns-lp-hero">
  {%- if section.settings.bg_image != blank -%}<div class="ns-lp-hero__bg">{% render 'ns-lp-media', image: section.settings.bg_image, eager: true, sizes: '100vw' %}</div>{%- endif -%}
  <div class="ns-lp__wrap ns-lp-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="ns-lp__h">{{ section.settings.heading }}</h1>
      <div class="ns-lp__sub">{{ section.settings.text }}</div>
      {%- if product -%}{% render 'ns-lp-form', product: product, fid: 'nslp-hero', select: false, qty: false, cls: 'ns-lp-form' %}{%- endif -%}
      {%- if section.settings.note != blank -%}<p class="ns-lp-hero__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
    <div class="ns-lp-hero__media">{% render 'ns-lp-media', image: section.settings.image, hint: section.settings.heading, eager: true, sizes: '(min-width: 990px) 45vw, 100vw' %}</div>
  </div>
</section>
{% schema %}
{ "name": "LP Hero", "tag": "div",
  "settings": [
    { "type": "text", "id": "topbar", "label": "Top bar text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Small note under buttons" },
    { "type": "image_picker", "id": "image", "label": "Image (right)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" }
  ], "presets": [{ "name": "LP Hero" }] }
{% endschema %}
