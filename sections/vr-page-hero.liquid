{%- liquid
  assign title = section.settings.heading | default: page.title
-%}
<section class="vr-section vr-section--{{ section.settings.background }} vr-pagehero{% if section.settings.image != blank %} vr-pagehero--image{% endif %}">
  <div class="vr-pagehero__glow" aria-hidden="true"></div>
  <div class="vr-container vr-pagehero__grid">
    <div class="vr-pagehero__content" data-vr-reveal>
      <nav class="vr-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ page.title | default: title }}</span>
      </nav>
      {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="vr-heading vr-pagehero__title">{{ title }}</h1>
      {%- if section.settings.text != blank -%}<div class="vr-sub">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="vr-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.button_label }}</span>{% render 'vr-icon', name: 'arrow', size: 18 %}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="vr-pagehero__media" data-vr-reveal>
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 45vw, 100vw', widths: '600, 900, 1200' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VR Page header",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "blush", "label": "Blush" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "VR Page header" }]
}
{% endschema %}
