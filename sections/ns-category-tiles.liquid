<section class="ns-section ns-cats">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="ns-title ns-center">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="ns-cats__grid ns-cats__grid--{{ section.blocks.size | at_most: 6 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign label = block.settings.title | default: c.title | default: 'Category'
          assign url = c.url | default: block.settings.link | default: routes.all_products_collection_url
          assign fallback = block.settings.fallback_asset | strip
        -%}
        <a class="ns-cat" href="{{ url }}" {{ block.shopify_attributes }}>
          <span class="ns-cat__img">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600, 700', alt: label }}
            {%- elsif fallback != blank -%}
              <img src="{{ fallback | asset_url }}" alt="" loading="lazy" width="700" height="700">
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'ns-placeholder' }}
            {%- endif -%}
          </span>
          <span class="ns-cat__label">{{ label }} <span aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NS Category tiles",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Label (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback image (theme asset)" },
        { "type": "url", "id": "link", "label": "Link if no collection" }
      ]
    }
  ],
  "presets": [{ "name": "NS Category tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
