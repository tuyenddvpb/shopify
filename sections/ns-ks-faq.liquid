{% render 'ns-ks-head' %}
<section class="ks ks__pad">
  <div class="ks__wrap ks-faq">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="ks__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ks__h ks__h--md">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ks__p">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="ks-acc">
      {%- for block in section.blocks -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="ks-acc__a">{{ block.settings.a }}</div></details>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "KS FAQ (dark)", "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "text", "id": "text", "label": "Text" } ],
  "blocks": [{ "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "q", "label": "Question", "default": "Question" },
    { "type": "richtext", "id": "a", "label": "Answer" } ] }],
  "presets": [{ "name": "KS FAQ (dark)" }] }
{% endschema %}
