{%- comment -%}
  Use only real, verified customer reviews. Hidden automatically when there are no blocks.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="vr-section vr-section--{{ section.settings.background }}">
    <div class="vr-container">
      <div class="vr-center">
        {%- if section.settings.eyebrow != blank -%}<p class="vr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="vr-heading">{{ section.settings.heading }}</h2>
      </div>
      <div class="vr-grid vr-grid--3">
        {%- for block in section.blocks -%}
          <figure class="vr-card" style="margin:0" {{ block.shopify_attributes }}>
            <div class="vr-review__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
            </div>
            <blockquote class="vr-review__quote" style="margin:0 0 16px">“{{ block.settings.quote }}”</blockquote>
            <figcaption>
              <div class="vr-review__author">{{ block.settings.author }}</div>
              {%- if block.settings.meta != blank -%}<div class="vr-review__meta">{{ block.settings.meta }}</div>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "VR Testimonials",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" },
        { "value": "white", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    {
      "type": "paragraph",
      "content": "Only add real, verified customer reviews. The section is hidden when it has no reviews."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 9,
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "text", "id": "meta", "label": "Details", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{ "name": "VR Testimonials" }]
}
{% endschema %}
