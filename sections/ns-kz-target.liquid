{% render 'ns-kz-head' %}
<section class="kz kz--navy" style="padding:0 0 72px">
  <div class="kz__wrap">
    <div class="kz-tg">
      <div class="kz-tg__copy"><h2 class="kz__h" style="font-size:clamp(28px,3vw,40px)">{{ section.settings.heading }}{%- if section.settings.accent != blank -%} <span class="kz__accent" style="display:inline">{{ section.settings.accent }}</span>{%- endif -%}</h2><p class="kz__p">{{ section.settings.sub }}</p></div>
      <div class="kz-tg__grid">
        {%- for block in section.blocks -%}<div class="kz-tg__item" {{ block.shopify_attributes }}>{% render 'ns-kz-torso', area: block.settings.area %}<span>{{ block.settings.label }}</span></div>{%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "KZ Target muscles", "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Target the" },
    { "type": "text", "id": "accent", "label": "Accent word", "default": "core" },
    { "type": "textarea", "id": "sub", "label": "Text" } ],
  "blocks": [{ "type": "area", "name": "Muscle area", "limit": 4, "settings": [
    { "type": "select", "id": "area", "label": "Area", "default": "upper", "options": [{"value":"upper","label":"Upper abs"},{"value":"mid","label":"Mid abs"},{"value":"lower","label":"Lower abs"},{"value":"obliques","label":"Obliques"}] },
    { "type": "text", "id": "label", "label": "Label", "default": "Upper abs" } ] }],
  "presets": [{ "name": "KZ Target muscles" }] }
{% endschema %}
