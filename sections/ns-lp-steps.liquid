{% render 'ns-lp-head' %}
<section class="ns-lp ns-lp--{{ section.settings.bg }} ns-lp__pad">
  <div class="ns-lp__wrap ns-lp__center">
    {%- if section.settings.eyebrow != blank -%}<p class="ns-lp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="ns-lp__h">{{ section.settings.heading }}</h2>
    <div class="ns-lp-steps">
      {%- for block in section.blocks -%}
        <div class="ns-lp-step" {{ block.shopify_attributes }}>
          <div class="ns-lp__frame ns-lp-step__media">{% render 'ns-lp-media', image: block.settings.image, ph: 'lifestyle-1', width: 800, sizes: '(min-width: 990px) 33vw, 100vw' %}</div>
          <span class="ns-lp-step__num">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "LP Steps", "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [{"value":"white","label":"White"},{"value":"cream","label":"Cream"},{"value":"sky","label":"Light blue"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" } ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Step" },
    { "type": "text", "id": "text", "label": "Text" } ] }],
  "presets": [{ "name": "LP Steps" }] }
{% endschema %}
