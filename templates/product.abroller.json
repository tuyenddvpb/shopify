    "faq": {
      "type": "ns-kz-faq",
      "blocks": {
        "q0": {
          "type": "qa",
          "settings": {
            "q": "What is this trainer?",
            "a": "<p>A four-wheel ab roller with padded forearm rests, a spring-assisted return, an adjustable handle and a built-in phone rest. A knee mat is included.</p>"
          }
        },
        "q1": {
          "type": "qa",
          "settings": {
            "q": "How does the spring-assisted return work?",
            "a": "<p>Steel springs inside the wheel housing help pull the roller back as you return to the start. You still control the speed and how far you roll.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Can beginners use it?",
            "a": "<p>Yes. Start from your knees with a short range of motion and a few slow reps, then build up gradually. Stop if you feel pain.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Is it only for abs?",
            "a": "<p>Rollouts mainly train your core, and your shoulders, arms and back work to stabilise you.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Does it need an app or batteries?",
            "a": "<p>No. It is fully mechanical. The phone rest simply holds your own phone if you want a timer or video in view.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Will it give me visible abs?",
            "a": "<p>No piece of equipment can promise that. Visible results depend on your overall routine, nutrition, sleep and starting point.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "Who should check with a doctor first?",
            "a": "<p>Anyone with back, shoulder, wrist or joint problems, people who are pregnant or recovering from surgery, or anyone unsure whether core exercise is right for them.</p>"
          }
        }
      },
