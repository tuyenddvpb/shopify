    "faq": {
      "type": "ns-ks-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "What knives does it work with?",
            "a": "<p>Most straight-edge kitchen and outdoor knives in stainless or carbon steel, including German-style and Japanese-style knives. It is not for serrated knives, scissors or ceramic blades.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "What's the difference between the discs?",
            "a": "<p><strong>Coarse diamond (240/400):</strong> resets dull or nicked edges. <strong>Fine diamond (600/1000):</strong> sharpens for everyday use. <strong>Whetstone 1200 and 5000:</strong> smooth and refine the edge. <strong>Polishing 10000:</strong> a very smooth finish. The Essential Kit has 400 and 1000; the Complete Kit has all six. For knives already in decent shape, start on a finer disc.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Which angle: 15° or 20°?",
            "a": "<p>Use 20° for Western chef's knives, everyday kitchen knives and outdoor knives. Use 15° for thin Japanese blades. If you're unsure, start with 20°.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "How long does it take?",
            "a": "<p>Usually a few minutes per knife. Very dull or chipped blades take longer on the coarse disc. Once the edge is set, a quick touch-up on the fine disc takes about a minute.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Is it safe to use?",
            "a": "<p>Keep your fingers on top of the roller and the block, away from the edge, and roll slowly. Keep it out of reach of children.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "Does it come in a gift box?",
            "a": "<p>It ships in plain protective packaging, ready for your own gift wrap.</p>"
