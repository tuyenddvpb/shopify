        "q1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Will it work for my knives?",
            "icon": "check_mark",
            "content": "<p>Yes, for most straight-edge kitchen and outdoor knives in stainless or carbon steel, including Japanese knives. It is not for serrated knives, scissors or ceramic blades.</p>",
            "page": ""
          }
        },
        "q2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Which angle should I use: 15° or 20°?",
            "icon": "question_mark",
            "content": "<p><strong>20°</strong> gives a sturdy, longer-lasting edge for Western chef's knives, everyday kitchen knives and outdoor knives. <strong>15°</strong> gives a finer, thinner edge for Japanese and other thin blades. Not sure? Start with 20°.</p>",
            "page": ""
          }
        },
        "q3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Rolling sharpener vs. other methods",
            "icon": "ruler",
            "content": "<p><strong>vs. whetstones:</strong> whetstones give great results but take practice to hold a steady angle. Here the block holds the angle for you.</p><p><strong>vs. pull-through sharpeners:</strong> quick, but the fixed slots can remove more metal and don't let you choose the angle.</p><p><strong>vs. a sharpening service:</strong> works well, but you pay per knife and wait. This stays in your drawer for whenever you need it.</p>",
            "page": ""
          }
        },
