    "faq": {
      "type": "vr-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "What is red light therapy?",
            "answer": "<p>Red light therapy uses low-level red and near-infrared light. VitalRay combines 660nm red light and 850nm near-infrared light in a wearable wrap for at-home use.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How often should I use it?",
            "answer": "<p>Most people use it once a day for a 15-minute session. The wrap turns off automatically when the session ends.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Does it get hot?",
            "answer": "<p>You may feel gentle warmth. If it ever feels uncomfortable, lower the intensity or stop the session.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Does it fit both hands?",
            "answer": "<p>Yes. The adjustable strap and thumb loop fit the left or right hand and most adult hand sizes.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Who should not use it?",
            "answer": "<p>Check with your doctor first if you are pregnant, have a pacemaker or other implanted device, are light-sensitive, or have a medical condition.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "How does the 90-day guarantee work?",
            "answer": "<p>If you're not happy within 90 days of delivery, email us with your order number and we'll refund you. See our refund policy for details.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are processed in 1–3 business days and usually arrive in 7–15 business days, with free tracking to the US, Canada, UK and Australia. See our <a href=\"/policies/shipping-policy\">Shipping Policy</a>.</p>"
          }
        },
