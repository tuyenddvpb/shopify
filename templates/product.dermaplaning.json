      "blocks": {
        "b1": {
          "type": "qa",
          "settings": {
            "q": "What does dermaplaning do?",
            "a": "It skims away fine facial hair (peach fuzz) and the dull top layer of dead skin, so skin feels smoother and makeup goes on more evenly."
          }
        },
        "b2": {
          "type": "qa",
          "settings": {
            "q": "Will my hair grow back thicker or darker?",
            "a": "No. The tool cuts fine vellus hair at the surface and doesn't affect the root, so it grows back the same as before."
          }
        },
        "b3": {
          "type": "qa",
          "settings": {
            "q": "How often should I use it?",
            "a": "About once a week is enough for most people. Give your skin time to recover between sessions."
          }
        },
        "b4": {
          "type": "qa",
          "settings": {
            "q": "Can I use it on my whole face?",
            "a": "Use it on the cheeks, jawline, chin, upper-lip area and forehead. Avoid the eyelids, lips and the sides of the nose."
          }
        },
        "b5": {
          "type": "qa",
          "settings": {
            "q": "Can I use it if I have acne or sensitive skin?",
            "a": "Don't use it over active breakouts, raised moles, broken, sunburned or irritated skin. If you have a skin condition or use prescription skincare, check with a dermatologist first."
          }
        },
        "b6": {
          "type": "qa",
          "settings": {
            "q": "How do I charge it?",
            "a": "Charge it with the included USB-C cable from a wall adapter, laptop or power bank. Charge it fully before the first use."
          }
        },
        "b7": {
          "type": "qa",
          "settings": {
            "q": "How often should I change the blade?",
            "a": "For hygiene and an even result, fit a fresh blade every session or as soon as it feels less smooth. The kit includes 5 replacement blades."
          }
        },
        "b8": {
          "type": "qa",
          "settings": {
            "q": "How long does shipping take?",
            "a": "Orders ship within 1–3 business days and usually arrive 7–15 business days later, with tracking. Shipping is free on orders over $49."
          }
        },
        "b9": {
          "type": "qa",
          "settings": {
            "q": "Can I use it in the shower?",
            "a": "The supplier rates the body IPX7, so you can rinse it under the tap. For the best result, use it on clean, dry skin and rinse the head afterwards."
